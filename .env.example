# ZMQ Inference – Environment Variables
# Copy to .env and adjust values as needed.

# Server bind host (use * for all interfaces)
ZMQ_HOST=*

# TCP port for the ZMQ ROUTER socket
ZMQ_PORT=5576

# timm model name (PyTorch backend only)
ZMQ_MODEL=mobilenetv2_100

# Compute device: auto | cpu | cuda
ZMQ_DEVICE=auto

# Client – server hostname to connect to
ZMQ_SERVER_HOST=localhost

# Client – receive timeout in milliseconds
ZMQ_TIMEOUT_MS=30000
